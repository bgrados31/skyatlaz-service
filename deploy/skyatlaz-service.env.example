# Environment of the skyatlaz-service systemd unit.
# Install as /etc/skyatlaz-service.env with mode 600 and owner root:root.
# systemd reads this file itself, so no .env and no dotenvy involved.

# Required. Your Hypixel developer key.
HYPIXEL_API_KEY=

# Required in production. Otherwise every restart invalidates all session tokens.
# Generate one with:
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
SKYATLAZ_TOKEN_SECRET=

# Caddy is the only thing that should reach the service, so keep it on loopback.
BIND=127.0.0.1:8080

# HYPIXEL_API_BASE=https://api.hypixel.net
# PROFILE_TTL_SECONDS=300
# TOKEN_TTL_SECONDS=3600
RUST_LOG=info
