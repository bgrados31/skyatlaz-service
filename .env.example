# Copy this file to .env and fill in your own values.
# .env is ignored by git. Never commit a real key.

# Required. Your Hypixel developer key, from https://developer.hypixel.net.
HYPIXEL_API_KEY=

# Optional. The secret that signs the session tokens. Generate one with:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
# At least 32 bytes. Left empty, the service uses a random secret per start and
# every session token dies when the service restarts.
SKYATLAZ_TOKEN_SECRET=

# Optional. The defaults are shown, uncomment to change them.
# BIND=127.0.0.1:8080
# HYPIXEL_API_BASE=https://api.hypixel.net
# PROFILE_TTL_SECONDS=300
# PROFILE_CACHE_ENTRIES=1024
# TOKEN_TTL_SECONDS=3600
# RUST_LOG=info

# Containers and PaaS set PORT instead of BIND. It listens on 0.0.0.0 on purpose;
# for a public host keep BIND on loopback and put a TLS proxy in front.
# PORT=8080
